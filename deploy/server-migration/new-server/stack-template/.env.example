# Stack settings for one slim project. add-project.sh writes the real .env
# (mode 600) with freshly generated secrets; this file only documents it.

# ── Generated by add-project.sh ───────────────────────────────────────────
POSTGRES_PASSWORD=generated
JWT_SECRET=generated
ANON_KEY=generated            # goes into the project's frontend
SERVICE_ROLE_KEY=generated    # never leaves the server
JWT_EXPIRY=3600

# ── Set by add-project.sh from its arguments ──────────────────────────────
KONG_HTTP_PORT=8010                              # loopback only, one per project
SUPABASE_PUBLIC_URL=https://api.example.com

# ── Resources: 3 of 4 cores and about 4.6 GB of the 8 GB server ──────────
# Memory ceilings are limits, not reservations.
DB_MEM_LIMIT=1280m
DB_SHARED_BUFFERS=384MB        # Postgres; the image's own config says 128MB
DB_EFFECTIVE_CACHE_SIZE=1GB    # Postgres planner hint; the image says 128MB
REST_MEM_LIMIT=512m
PGRST_DB_POOL=20               # database connections kept by REST (default 10)
KONG_MEM_LIMIT=768m
FUNCTIONS_MEM_LIMIT=2048m      # 512m crashed under normal page loads
FUNCTIONS_CPUS=3               # leaves the other stacks one of the 4 cores

# ── Edge function limits per worker (Supabase cloud: 256 MB, 150 s) ──────
EDGE_WORKER_MEMORY_MB=512
EDGE_WORKER_TIMEOUT_MS=150000
EDGE_WORKER_CPU_SOFT_MS=15000  # CPU time summed over a worker's requests: retire
EDGE_WORKER_CPU_HARD_MS=45000  # ... and cancel what still runs (main/index.ts)

# ── Worker pool: at most this many workers at once; extra requests wait ──
EDGE_MAX_PARALLELISM=8
EDGE_REQUEST_WAIT_TIMEOUT_MS=30000

# ── nginx rate limit per client IP (re-run add-project.sh after a change) ─
NGINX_RATE=40r/s
NGINX_BURST=120
