# Stack settings for one slim project. add-project.sh writes the real .env
# (mode 600) with freshly generated secrets; this file only documents it.

# ── Generated by add-project.sh ───────────────────────────────────────────
POSTGRES_PASSWORD=generated
JWT_SECRET=generated
ANON_KEY=generated            # goes into the project's frontend
SERVICE_ROLE_KEY=generated    # never leaves the server
JWT_EXPIRY=3600

# ── Set by add-project.sh from its arguments ──────────────────────────────
KONG_HTTP_PORT=8010                              # loopback only, one per project
SUPABASE_PUBLIC_URL=https://api.example.com

# ── Memory ceilings (not reservations) ────────────────────────────────────
DB_MEM_LIMIT=768m
REST_MEM_LIMIT=384m
KONG_MEM_LIMIT=512m
FUNCTIONS_MEM_LIMIT=512m

# ── Edge function limits per request (Supabase cloud: 256 MB, 150 s) ─────
EDGE_WORKER_MEMORY_MB=256
EDGE_WORKER_TIMEOUT_MS=150000
