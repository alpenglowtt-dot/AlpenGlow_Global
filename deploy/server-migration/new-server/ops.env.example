# Settings for backup-nightly.sh and healthcheck.sh. Lives at ~/ops/ops.env
# on the server (mode 600). All optional. The projects they cover are the
# files in ~/ops/projects/, one per project.

# Off-server copy of each night's backup. Leave empty for local-only.
# Each night's folder is encrypted with ~/ops/backup.passphrase before upload.
# Keep a copy of that passphrase somewhere other than this server.
# After `rclone config` has created a remote named r2 for Cloudflare R2:
#   RCLONE_REMOTE="r2:alpenglow-backups"
RCLONE_REMOTE=""

# Where health alerts go, for every project. Empty means AGENCY_EMAIL from
# AlpenGlow's backend .env, whose Resend key also sends the alerts.
ALERT_TO=""

# Days of backups kept on the server itself.
KEEP_DAYS=14
