# __PROJECT__ API. Written by add-project.sh from nginx/project-site.template.
#
# Only /functions/v1/ is reachable: the project's frontend calls edge functions
# and nothing else, so REST, Studio and Auth paths stay closed. Rate limited
# per IP in this project's own zone (__ZONE__).

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 5m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /functions/v1/ {
        limit_req zone=__ZONE__ burst=60 nodelay;
        include snippets/proxy-to-stack.conf;
        proxy_pass http://127.0.0.1:__PORT__;
    }

    location / { return 404; }
}
