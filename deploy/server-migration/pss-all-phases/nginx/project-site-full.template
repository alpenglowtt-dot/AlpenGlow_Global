# __PROJECT__ API (full stack). Written by add-project-full.sh from
# nginx/project-site-full.template (a copy of new-server's project-site.template).
#
# Reachable from the internet, and nothing else:
#   /functions/v1/<name>              edge functions (not "main", not "_shared")
#   GET/HEAD /storage/v1/object/sign/ signed Storage links the functions hand out
#   /realtime/v1/websocket            Realtime websocket (broadcast signals)
# Everything else is 404 for EVERYONE, with no exception for internal or Docker
# addresses: /rest/v1/, /auth/v1/, all other /storage/v1/ paths (bucket admin,
# uploads, public objects, S3), /realtime/v1/api/, Studio, /pg/, GraphQL. The
# functions reach REST, Storage and the broadcast API inside the stack through
# http://kong:8000, never through this site.
# Rate limited per IP in this project's own zone (__ZONE__).

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 5m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # The router and the shared code folder are not functions.
    location ~ ^/functions/v1/(main|_shared)(/|$) { return 404; }

    location /functions/v1/ {
        limit_req zone=__ZONE__ burst=60 nodelay;
        include snippets/proxy-to-stack.conf;
        proxy_pass http://127.0.0.1:__PORT__;
    }

    # Signed links only (the token in the link is checked by storage-api).
    # Creating a link (POST to this path) stays closed: only the functions
    # create links, inside the stack.
    location /storage/v1/object/sign/ {
        limit_except GET { deny all; }   # GET also allows HEAD
        limit_req zone=__ZONE__ burst=60 nodelay;
        include snippets/proxy-to-stack.conf;
        proxy_pass http://127.0.0.1:__PORT__;
    }

    # Realtime websocket. Headers set here rather than through the snippet,
    # because the snippet's 120 s read timeout would cut idle sockets.
    location = /realtime/v1/websocket {
        limit_req zone=__ZONE__ burst=60 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:__PORT__;
    }

    location / { return 404; }
}
