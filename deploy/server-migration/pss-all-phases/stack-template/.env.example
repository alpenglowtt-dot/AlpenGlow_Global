# Stack settings for one full project (with Storage and Realtime).
# add-project-full.sh writes the real .env (mode 600) with freshly generated
# secrets; this file only documents it. Never put real values here.

# ── Generated by add-project-full.sh ──────────────────────────────────────
POSTGRES_PASSWORD=generated
JWT_SECRET=generated
ANON_KEY=generated            # goes into the project's frontend
SERVICE_ROLE_KEY=generated    # never leaves the server
JWT_EXPIRY=3600
SECRET_KEY_BASE=generated     # Realtime, 64 hex characters
REALTIME_DB_ENC_KEY=generated # Realtime, exactly 16 characters
S3_PROTOCOL_ACCESS_KEY_ID=generated      # Storage S3 protocol (never exposed)
S3_PROTOCOL_ACCESS_KEY_SECRET=generated

# ── Set by add-project-full.sh from its arguments ─────────────────────────
KONG_HTTP_PORT=8010                              # loopback only, one per project
SUPABASE_PUBLIC_URL=https://api.example.com

# ── Memory ceilings (not reservations); total about 2.7 GB ────────────────
DB_MEM_LIMIT=768m
REST_MEM_LIMIT=256m
KONG_MEM_LIMIT=512m
FUNCTIONS_MEM_LIMIT=512m
STORAGE_MEM_LIMIT=256m
REALTIME_MEM_LIMIT=384m

# ── Edge function limits per request (Supabase cloud: 256 MB, 150 s) ─────
EDGE_WORKER_MEMORY_MB=256
EDGE_WORKER_TIMEOUT_MS=150000
